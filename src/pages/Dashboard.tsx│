import React from "react";
import {
  Users,
  GraduationCap,
  HeartHandshake,
  ClipboardList,
  ShieldCheck,
  IndianRupee,
  Activity,
  ArrowRight,
  Database,
  TrendingUp,
  RefreshCw,
  CheckCircle2,
} from "lucide-react";

import { CrmDatabase } from "../types";

interface DashboardProps {
  data: CrmDatabase;
  onNavigate: (tab: string) => void;
}

export default function Dashboard({
  data,
  onNavigate,
}: DashboardProps) {
  // Safe Arrays
  const donors = data?.donors ?? [];
  const students = data?.students ?? [];
  const volunteers = data?.volunteers ?? [];
  const tasks = data?.taskList ?? data?.tasks ?? [];
  const compliance =
    data?.legalCompliance ??
    data?.complianceStatus ??
    [];
  const donations = data?.donations ?? [];

  // KPI
  const totalDonations = donations.reduce(
    (sum: number, d: any) => sum + Number(d.amount || 0),
    0
  );

  const enrolledStudents = students.filter(
    (s: any) => s.status === "Enrolled"
  ).length;

  const activeVolunteers = volunteers.filter(
    (v: any) => v.status === "Active"
  ).length;

  const pendingTasks = tasks.filter(
    (t: any) => t.status === "Pending"
  ).length;

  const reviewCompliance = compliance.filter(
    (c: any) => c.status === "Review Required"
  ).length;

  const cards = [
    {
      title: "Total Donations",
      value: `₹${totalDonations.toLocaleString()}`,
      icon: IndianRupee,
      color: "bg-emerald-500",
    },
    {
      title: "Students",
      value: enrolledStudents,
      icon: GraduationCap,
      color: "bg-blue-500",
    },
    {
      title: "Volunteers",
      value: activeVolunteers,
      icon: HeartHandshake,
      color: "bg-purple-500",
    },
    {
      title: "Pending Tasks",
      value: pendingTasks,
      icon: ClipboardList,
      color: "bg-orange-500",
    },
    {
      title: "Compliance",
      value: reviewCompliance,
      icon: ShieldCheck,
      color: "bg-red-500",
    },
  ];

  return (
    <div className="space-y-8">

      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold text-slate-900">
            Dashboard
          </h1>

          <p className="text-slate-500 mt-1">
            Navyug AI Office Overview
          </p>
        </div>

        <button
          onClick={() => onNavigate("workspace")}
          className="flex items-center gap-2 bg-indigo-600 text-white px-5 py-2 rounded-xl hover:bg-indigo-700 transition"
        >
          Workspace Hub
          <ArrowRight className="w-4 h-4" />
        </button>
      </div>

      {/* KPI Cards */}

      <div className="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {cards.map((card) => {
          const Icon = card.icon;

          return (
            <div
              key={card.title}
              className="bg-white rounded-2xl shadow-sm border border-slate-200 p-5"
            >
              <div className="flex justify-between items-center">

                <div>
                  <p className="text-xs uppercase tracking-wide text-slate-500">
                    {card.title}
                  </p>

                  <h2 className="text-3xl font-bold mt-2">
                    {card.value}
                  </h2>
                </div>

                <div
                  className={`${card.color} w-12 h-12 rounded-xl flex items-center justify-center text-white`}
                >
                  <Icon className="w-6 h-6" />
                </div>

              </div>
            </div>
          );
        })}
      </div>
            {/* Main Dashboard Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {/* Recent Donors */}
        <div className="bg-white rounded-2xl shadow border border-slate-200 p-6">
          <div className="flex items-center gap-2 mb-4">
            <Users className="w-5 h-5 text-indigo-600" />
            <h3 className="font-bold text-lg">Recent Donors</h3>
          </div>

          {(donors ?? []).length === 0 ? (
            <p className="text-slate-500 text-sm">
              No donor records found.
            </p>
          ) : (
            <div className="space-y-3">
              {(donors ?? []).slice(0, 5).map((donor: any, index: number) => (
                <div
                  key={donor.id ?? index}
                  className="flex justify-between items-center border-b pb-2"
                >
                  <div>
                    <div className="font-semibold">
                      {donor.name || "Unknown"}
                    </div>
                    <div className="text-xs text-slate-500">
                      {donor.phone || "-"}
                    </div>
                  </div>

                  <div className="font-bold text-emerald-600">
                    ₹{Number(donor.amount || 0).toLocaleString()}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Students */}
        <div className="bg-white rounded-2xl shadow border border-slate-200 p-6">
          <div className="flex items-center gap-2 mb-4">
            <GraduationCap className="w-5 h-5 text-blue-600" />
            <h3 className="font-bold text-lg">
              Students
            </h3>
          </div>

          {(students ?? []).length === 0 ? (
            <p className="text-slate-500 text-sm">
              No students available.
            </p>
          ) : (
            <div className="space-y-3">
              {(students ?? []).slice(0, 5).map((student: any, index: number) => (
                <div
                  key={student.id ?? index}
                  className="flex justify-between border-b pb-2"
                >
                  <div>
                    <div className="font-semibold">
                      {student.name}
                    </div>

                    <div className="text-xs text-slate-500">
                      {student.course || "-"}
                    </div>
                  </div>

                  <span
                    className={`text-xs px-2 py-1 rounded-full ${
                      student.status === "Enrolled"
                        ? "bg-green-100 text-green-700"
                        : "bg-slate-100 text-slate-600"
                    }`}
                  >
                    {student.status}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Volunteers */}
        <div className="bg-white rounded-2xl shadow border border-slate-200 p-6">
          <div className="flex items-center gap-2 mb-4">
            <HeartHandshake className="w-5 h-5 text-purple-600" />
            <h3 className="font-bold text-lg">
              Volunteers
            </h3>
          </div>

          {(volunteers ?? []).length === 0 ? (
            <p className="text-slate-500 text-sm">
              No volunteers available.
            </p>
          ) : (
            <div className="space-y-3">
              {(volunteers ?? []).slice(0, 5).map((volunteer: any, index: number) => (
                <div
                  key={volunteer.id ?? index}
                  className="flex justify-between border-b pb-2"
                >
                  <div>
                    <div className="font-semibold">
                      {volunteer.name}
                    </div>

                    <div className="text-xs text-slate-500">
                      {volunteer.role || "-"}
                    </div>
                  </div>

                  <span
                    className={`text-xs px-2 py-1 rounded-full ${
                      volunteer.status === "Active"
                        ? "bg-green-100 text-green-700"
                        : "bg-red-100 text-red-700"
                    }`}
                  >
                    {volunteer.status}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>

      </div>
            {/* Tasks + Compliance */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">

        {/* Pending Tasks */}
        <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <div className="flex items-center gap-2 mb-5">
            <ClipboardList className="w-5 h-5 text-orange-500" />
            <h3 className="text-lg font-bold">
              Pending Tasks
            </h3>
          </div>

          {(tasks ?? []).length === 0 ? (
            <p className="text-sm text-slate-500">
              No pending tasks.
            </p>
          ) : (
            <div className="space-y-3">
              {(tasks ?? [])
                .filter((t: any) => t.status === "Pending")
                .slice(0, 6)
                .map((task: any, index: number) => (
                  <div
                    key={task.id ?? index}
                    className="flex items-start justify-between border-b pb-3"
                  >
                    <div>
                      <h4 className="font-semibold">
                        {task.title || "Untitled Task"}
                      </h4>

                      <p className="text-xs text-slate-500">
                        {task.assignedTo || "Unassigned"}
                      </p>
                    </div>

                    <span className="text-xs px-2 py-1 rounded-full bg-orange-100 text-orange-700">
                      Pending
                    </span>
                  </div>
                ))}
            </div>
          )}
        </div>

        {/* Compliance */}
        <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <div className="flex items-center gap-2 mb-5">
            <ShieldCheck className="w-5 h-5 text-red-500" />

            <h3 className="text-lg font-bold">
              Compliance Review
            </h3>
          </div>

          {(compliance ?? []).length === 0 ? (
            <p className="text-sm text-slate-500">
              No compliance records.
            </p>
          ) : (
            <div className="space-y-3">
              {(compliance ?? [])
                .slice(0, 6)
                .map((item: any, index: number) => (
                  <div
                    key={item.id ?? index}
                    className="flex justify-between border-b pb-3"
                  >
                    <div>
                      <h4 className="font-semibold">
                        {item.title || item.name || "Compliance"}
                      </h4>

                      <p className="text-xs text-slate-500">
                        {item.description || ""}
                      </p>
                    </div>

                    <span
                      className={`text-xs px-2 py-1 rounded-full ${
                        item.status === "Completed"
                          ? "bg-green-100 text-green-700"
                          : item.status === "Review Required"
                          ? "bg-red-100 text-red-700"
                          : "bg-slate-100 text-slate-600"
                      }`}
                    >
                      {item.status}
                    </span>
                  </div>
                ))}
            </div>
          )}
        </div>

      </div>

      {/* Recent Activity */}
      <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

        <div className="flex items-center gap-2 mb-5">
          <Activity className="w-5 h-5 text-indigo-600" />

          <h3 className="text-lg font-bold">
            Recent Activity
          </h3>
        </div>

        {(data.activityLogs ?? []).length === 0 ? (
          <p className="text-sm text-slate-500">
            No recent activity found.
          </p>
        ) : (
          <div className="space-y-4">
            {(data.activityLogs ?? [])
              .slice(0, 8)
              .map((log: any, index: number) => (
                <div
                  key={log.id ?? index}
                  className="flex justify-between border-b pb-3"
                >
                  <div>
                    <div className="font-medium">
                      {log.action || "Activity"}
                    </div>

                    <div className="text-xs text-slate-500">
                      {log.user || "System"}
                    </div>
                  </div>

                  <div className="text-xs text-slate-400">
                    {log.createdAt ||
                      log.created_at ||
                      "-"}
                  </div>
                </div>
              ))}
          </div>
        )}
      </div>
            {/* Quick Actions */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-6">

        <button
          onClick={() => onNavigate("workforce")}
          className="bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl p-6 transition text-left"
        >
          <Users className="w-8 h-8 mb-3" />

          <h3 className="font-bold text-lg">
            AI Workforce
          </h3>

          <p className="text-indigo-100 text-sm mt-2">
            Open AI Employees
          </p>
        </button>

        <button
          onClick={() => onNavigate("workspace")}
          className="bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl p-6 transition text-left"
        >
          <Database className="w-8 h-8 mb-3" />

          <h3 className="font-bold text-lg">
            Workspace
          </h3>

          <p className="text-emerald-100 text-sm mt-2">
            Manage CRM Database
          </p>
        </button>

        <button
          onClick={() => onNavigate("ceo")}
          className="bg-orange-600 hover:bg-orange-700 text-white rounded-2xl p-6 transition text-left"
        >
          <TrendingUp className="w-8 h-8 mb-3" />

          <h3 className="font-bold text-lg">
            CEO Briefing
          </h3>

          <p className="text-orange-100 text-sm mt-2">
            Executive Reports
          </p>
        </button>

        <button
          onClick={() => window.location.reload()}
          className="bg-slate-700 hover:bg-slate-800 text-white rounded-2xl p-6 transition text-left"
        >
          <RefreshCw className="w-8 h-8 mb-3" />

          <h3 className="font-bold text-lg">
            Refresh
          </h3>

          <p className="text-slate-200 text-sm mt-2">
            Reload Dashboard
          </p>
        </button>

      </div>

      {/* System Status */}
      <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

        <div className="flex items-center justify-between">

          <div>
            <h3 className="text-xl font-bold">
              System Status
            </h3>

            <p className="text-sm text-slate-500">
              Navyug AI Office Runtime
            </p>
          </div>

          <div className="flex items-center gap-2 text-green-600 font-semibold">
            <CheckCircle2 className="w-5 h-5" />
            Online
          </div>

        </div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-6 mt-8">

          <div>
            <div className="text-xs uppercase text-slate-500">
              Donors
            </div>

            <div className="text-2xl font-bold">
              {donors.length}
            </div>
          </div>

          <div>
            <div className="text-xs uppercase text-slate-500">
              Students
            </div>

            <div className="text-2xl font-bold">
              {students.length}
            </div>
          </div>

          <div>
            <div className="text-xs uppercase text-slate-500">
              Volunteers
            </div>

            <div className="text-2xl font-bold">
              {volunteers.length}
            </div>
          </div>

          <div>
            <div className="text-xs uppercase text-slate-500">
              Tasks
            </div>

            <div className="text-2xl font-bold">
              {tasks.length}
            </div>
          </div>

        </div>

      </div>

    </div>
  );
}
